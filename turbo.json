{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "100%",
  "ui": "stream",
  "tasks": {
    "build": {
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputLogs": "new-only"
    },
    "test:coverage": {
      "outputLogs": "new-only"
    },
    "test:watch": {
      "outputLogs": "new-only"
    },
    "test": {
      "outputLogs": "new-only"
    },
    "typecheck": {
      "outputLogs": "new-only"
    }
  }
}
