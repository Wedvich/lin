{
  "name": "lin",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Wedvich/lin"
  },
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "configs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --continue",
    "dev": "turbo run dev --continue --ui tui",
    "lint": "turbo run lint --continue",
    "postinstall": "husky || true",
    "start": "docker compose -f docker-compose.yml up --remove-orphans",
    "test:coverage": "turbo run test:coverage --continue",
    "test:watch": "turbo run test:watch --continue",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck --continue"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lin/lint-staged": "workspace:*",
    "@lin/tsconfig": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
